{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TK-OPS",
  "version": "0.4.11",
  "identifier": "com.tkops.desktop",
  "build": {
    "beforeDevCommand": "npm run prepare:runtime-sidecar && npm run prepare:media-tools && npm run dev",
    "beforeBuildCommand": "npm run prepare:runtime-sidecar && npm run prepare:media-tools && npm run build",
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420"
  },
  "app": {
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPLOCALDATA/runtime/accounts/**/*"
        ]
      }
    },
    "windows": [
      {
        "label": "main",
        "title": "TK-OPS",
        "width": 1680,
        "height": 960,
        "minWidth": 960,
        "minHeight": 720,
        "resizable": true,
        "maximizable": true,
        "minimizable": true,
        "closable": true,
        "decorations": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "resources": {
      "binaries/tk-ops-runtime-x86_64-pc-windows-msvc.exe": "resources/runtime/tk-ops-runtime.exe",
      "resources/bin/ffprobe/windows-x64/ffprobe.exe": "resources/bin/ffprobe/windows-x64/ffprobe.exe",
      "resources/runtime/runtime-supervisor.bootstrap.json": "resources/runtime/runtime-supervisor.bootstrap.json",
      "resources/runtime/tk-ops-runtime.manifest.json": "resources/runtime/tk-ops-runtime.manifest.json"
    },
    "icon": [
      "../../../tkops.ico"
    ]
  }
}
