{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "jsx": "preserve",
    "sourceMap": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "vitest"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "src/**/*.tsx", "src/**/*.vue", "vite.config.ts"],
  "exclude": [
    "src/app/runtime-client.ts",
    "src/bootstrap/bootstrap-form.ts",
    "src/bootstrap/BootstrapInitializationScreen.vue",
    "src/bootstrap/BootstrapLicenseScreen.vue",
    "src/components/PagePlaceholderState.vue",
    "src/components/assets/**",
    "src/components/common/ProjectContextGuard.vue",
    "src/components/shell/**",
    "src/layouts/AppShell.vue",
    "src/layouts/shell/**",
    "src/modules/renders/**",
    "src/modules/scripts/**",
    "src/modules/settings/**",
    "src/modules/storyboards/**",
    "src/modules/subtitles/**",
    "src/modules/voice/**",
    "src/modules/workspace/**",
    "src/pages/accounts/**",
    "src/pages/assets/**",
    "src/pages/automation/**",
    "src/pages/dashboard/**",
    "src/pages/devices/**",
    "src/pages/publishing/**",
    "src/pages/renders/**",
    "src/pages/review/**",
    "src/pages/scripts/**",
    "src/pages/settings/AISystemSettingsPage.vue",
    "src/pages/settings/ai-system-settings-page-helpers.ts",
    "src/pages/settings/components/**",
    "src/pages/settings/types.ts",
    "src/pages/settings/use-*.ts",
    "src/pages/setup/SetupLicenseWizardPage.vue",
    "src/pages/storyboards/**",
    "src/pages/subtitles/**",
    "src/pages/video/**",
    "src/pages/voice/**",
    "src/pages/workspace/**",
    "src/stores/**",
    "src/types/runtime.ts",
    "src/types/task-events.ts",
    "src/types/video.ts"
  ],
  "references": []
}
