{
  "name": "tk-ops-assistant-v3",
  "private": true,
  "version": "0.4.11",
  "packageManager": "npm@11.6.2",
  "scripts": {
    "test": "npm run test:runtime && npm run test:desktop",
    "test:runtime": "node scripts/run-runtime-tests.mjs",
    "test:desktop": "npm --prefix apps/desktop run test",
    "typecheck": "npm --prefix apps/desktop run typecheck",
    "test:e2e": "npm --prefix apps/desktop run test:e2e",
    "test:sidecar-smoke": "node scripts/tauri-sidecar-smoke.mjs",
    "test:installer-smoke": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$script = Get-Content -LiteralPath 'tests/packaging/windows-installer-smoke.ps1' -Raw -Encoding UTF8; & ([ScriptBlock]::Create($script))\"",
    "release:manifest:create": "node scripts/create-release-manifest.mjs",
    "release:manifest:verify": "node scripts/verify-release-manifest.mjs",
    "build:windows-release": "node scripts/build-windows-release.mjs",
    "desktop:dev": "npm --prefix apps/desktop run dev",
    "desktop:build": "npm --prefix apps/desktop run build",
    "desktop:tauri": "npm --prefix apps/desktop run tauri",
    "runtime:sidecar:prepare": "node scripts/prepare-runtime-sidecar.mjs",
    "runtime:dev": "node scripts/run-runtime-dev.mjs",
    "runtime:seed-dev": "node scripts/seed-runtime-dev.mjs --reset-dev-seed",
    "desktop:tauri:dev": "npm --prefix apps/desktop run tauri -- dev",
    "app:dev": "npm run desktop:tauri:dev",
    "version:sync": "node scripts/version-sync.mjs",
    "version:check": "node scripts/version-check.mjs"
  }
}
